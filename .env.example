# Copy this file to .env and adjust as needed.
# .env is gitignored — never commit credentials.

# SQLAlchemy URL used by src/db/connection.py.
# Default targets the air-quality database in the docker-compose Postgres.
# pg_hba.conf grants `trust` auth, so no password is required locally.
DATABASE_URL=postgresql+psycopg://smartmonitoring_airquality@localhost:5432/smartmonitoring_airquality

# Other databases that ship in the cluster (run `\l` in psql to confirm):
#   data_environmental, smartdatalyser, smartdataporter,
#   smartmonitoring_test, smartuser
