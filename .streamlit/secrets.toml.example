# Copy to .streamlit/secrets.toml (gitignored) for local use with a hosted DB,
# OR paste the same key into Streamlit Community Cloud → app → Settings → Secrets.
#
# Use your hosted Postgres+PostGIS connection string (e.g. from Neon). A bare
# postgresql:// URL is fine — the app rewrites the scheme to use psycopg 3.
# Keep ?sslmode=require (Neon requires TLS).

DATABASE_URL = "postgresql://USER:PASSWORD@ep-xxxx-xxxx.eu-central-1.aws.neon.tech/DBNAME?sslmode=require"
